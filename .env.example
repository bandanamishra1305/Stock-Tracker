# StockTrack Environment Configuration Template
# Copy this file to .env and configure your secrets

PORT=8000
DATABASE_URL=sqlite:///./stocktrack.db

# Admin User Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Time-based One-Time Password 2FA Secret Key
# Must be a valid Base32 key (e.g. JBSWY3DPEHPK3PXP)
# You can generate one using: python -c "import pyotp; print(pyotp.random_base32())"
TOTP_SECRET=JBSWY3DPEHPK3PXP

# Secret key for JWT sessions signature verification
JWT_SECRET=super_secret_jwt_key_stocktrack
